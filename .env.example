# Control plane
# Local PostgreSQL that `rehearsal up` starts in Docker. A managed database also works: give Rehearsal
# a role and schema of its own, never "public", and add sslmode=verify-full&sslrootcert=<CA file> to the URL.
REHEARSAL_DATABASE_URL=postgresql+psycopg://rehearsal:rehearsal@127.0.0.1:5433/rehearsal
REHEARSAL_DATA_DIR=./var
REHEARSAL_SESSION_SECRET=change-me
# Comma-separated directories the runner may read local application sources from.
REHEARSAL_SOURCE_ROOTS=./examples

# Models: every role runs on Meta's Muse models through the Meta Model API, so MODEL_API_KEY is the only model key.
# The Rehearsal library names no model; these lines choose them. A chain is provider:model[#effort][,...], tried in
# order; #minimal, #low, #medium, #high, #xhigh or #max sets reasoning_effort for that entry. A role left empty uses
# the compiler's chain (the improver uses the reasoner's).
# The reasoner (designing, judging and repairing jobs, proposing a better agent) gets Muse Wonder, where a wrong answer
# costs a whole build. The agent under test has one model, so a run never mixes models. The simulated customer sees
# only fictional world data, so it uses Muse Spark's Contributor tier: about 12 times cheaper, and Meta may train on
# those prompts; Standard is behind it for when Contributor's 150 requests a minute run out.
# Muse Glimmer on your own machine (vLLM or llama.cpp): local:<model>, with REHEARSAL_LOCAL_BASE_URL.
REHEARSAL_MODEL_COMPILER=meta:muse-spark-1.3#medium
REHEARSAL_MODEL_REASONER=meta:muse-wonder-1.0#high,meta:muse-spark-1.3#xhigh
REHEARSAL_MODEL_AGENT=meta:muse-spark-1.3#medium
REHEARSAL_MODEL_PARTICIPANT=meta:muse-spark-1.3-contributor#minimal,meta:muse-spark-1.3#minimal
# Meta Model API prices are in pricing.yaml. A local model needs its price: USD per 1M tokens [input, output], e.g.
# {"local:muse-glimmer-30b": [0, 0]}, or an entry in pricing.yaml
REHEARSAL_PRICES={}

# The Meta Model API is this project's provider, declared here because the Rehearsal library names no vendor:
# the address, the setting that holds the key, and tool_choice "auto" (the only value the API accepts).
REHEARSAL_PROVIDERS={"meta": {"base_url": "https://api.meta.ai/v1", "api_key_env": "MODEL_API_KEY", "tool_choice": "auto"}}
# Meta Model API (dev.meta.ai): Muse Spark and Muse Wonder
MODEL_API_KEY=
# Web research for the World Compiler (Tavily): with a key, each build first studies how real people use the
# application (docs, forums, issue trackers) and bases its jobs on that, citing the pages. Without one, it is skipped.
TAVILY_API_KEY=
KAGGLE_API_TOKEN=

# "open" lets anyone create an organisation and an admin API key from the console sign-up form; "closed" turns that off
REHEARSAL_SIGNUP=open
# Google sign-in for the console (OAuth web client ID)
GOOGLE_CLIENT_ID=

# Hosted plans and payments. Leave REHEARSAL_PLANS=off on a private server.
REHEARSAL_PLANS=off
# Operator admins, comma-separated; they must sign in with Google
REHEARSAL_ADMIN_EMAILS=
# Free-plan evaluations start only in this window (UTC, HH:MM-HH:MM, may cross midnight)
REHEARSAL_QUIET_HOURS_UTC=18:00-02:00
# Where browsers reach this server (Dodo checkout returns here)
REHEARSAL_PUBLIC_URL=http://localhost:7800
# The documentation site; /docs redirects there. Start it with `cd docs && pnpm dev`. Empty: /docs is the API reference (/api/docs)
REHEARSAL_DOCS_URL=http://localhost:7801
# Dodo Payments (dashboard: Developer > API keys, Developer > Webhooks). test_mode or live_mode.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product ids (pdt_...): four subscriptions and two one-time top-ups
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_PRODUCT_TEAM_MONTHLY=
DODO_PRODUCT_TEAM_YEARLY=
DODO_PRODUCT_EPISODES_1000=
DODO_PRODUCT_BUILD_1=

